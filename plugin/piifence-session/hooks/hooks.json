{
  "description": "piifence session hooks, run by the piifence binary that started this Claude Code",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PIIF_BIN\" session-start \"$PIIF_SESSION\" \"$PIIF_SESSION_PORT\" $PIIF_SESSION_NESTED"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PIIF_BIN\" restore \"$PIIF_SESSION\" \"$PIIF_SESSION_PORT\""
          }
        ]
      }
    ]
  }
}
