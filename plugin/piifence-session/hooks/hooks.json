{
  "description": "piifence session hooks: bind the Claude Code session on the gateway and put real values into tool calls",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@PIIFENCE@ session-start @PORT@"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "@PIIFENCE@ restore @PORT@"
          }
        ]
      }
    ]
  }
}
